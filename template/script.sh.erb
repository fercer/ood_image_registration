#!/usr/bin/env bash

OOD_OUTPUT_DIR="$(pwd)"

# Set working directory to home directory
cd "${HOME}"

# Clear any existing XDG_RUNTIME_DIR to avoid warnings from dconf
unset XDG_RUNTIME_DIR

<%- unless context.modules.blank? -%>
# Purge the module environment to avoid conflicts
module purge

# Load the require modules
module load <%= context.modules %>

# List loaded modules
module list
<%- end -%>

# Benchmark info
echo "TIMING - Starting Image Registration at: $(date)"

# Launch the Image Registration job

TEMP_DIR="<%= context.temp_dir %>"
PROCESSING_SIZE="<%= context.processing_size %>"
CODEC="<%= context.output_codec %>"
QUALITY="<%= context.output_codec_quality %>"
OUTPUT_DIR="<%= context.output_dir %>"

if [ "${OUTPUT_DIR}" == "" ]; then
    echo "The output directory was not defined. It will be set to the home directory '${HOME}'."
    OUTPUT_DIR="${HOME}"
fi
if [ ! -d "${OUTPUT_DIR}" ]; then
    echo "The output directory '${OUTPUT_DIR}' does not exist and will be created."
    mkdir -p "${OUTPUT_DIR}"
fi

# Check whether the directory was created successfully or not
if [ ! -d "${OUTPUT_DIR}" ]; then
    echo "Could not find output directory '${OUTPUT_DIR}'."
    exit 1
fi

if [ "${TEMP_DIR}" == "" ]; then
    echo "The temporary directory was not defined. It will be set to the same output directory '${OUTPUT_DIR}'."
    TEMP_DIR=${OUTPUT_DIR}
fi
if [ ! -d "${TEMP_DIR}" ]; then
    echo "The temporary directory '${TEMP_DIR}' does not exist and will be created."
    mkdir -p "${TEMP_DIR}"
fi

# Check whether the directory was created successfully or not
if [ ! -d "${TEMP_DIR}" ]; then
    echo "Could not find temporary directory '${TEMP_DIR}'."
    exit 1
fi

REFERENCE_FILENAME="<%= context.reference_image %>"
INPUT_FILENAME="<%= context.input_image %>"

if [ ! -f "$REFERENCE_FILENAME" ]; then
    echo "Could not find reference image '${REFERENCE_FILENAME}'"
    exit 1
fi

if [ ! -f "$INPUT_FILENAME" ]; then
    echo "Could not find input image '${INPUT_FILENAME}'"
    exit 1
fi

REFERENCE_BASENAME=$(basename "$REFERENCE_FILENAME")
if [[ ${REFERENCE_BASENAME} != *".ome.tif"* ]]; then
    REFERENCE_BASENAME="${REFERENCE_BASENAME%.*}"
else
    REFERENCE_BASENAME="${REFERENCE_BASENAME%.ome.tif*}"
fi

# ----------------- Registration pipeline ------------------------------------------------------------------------------------------

# Use a writable file to store compatible bioformats
BF_FORMAT_F=${TEMP_DIR}/.cache/bf_formats.txt
if [ ! -f "$BF_FORMAT_F" ]; then
    BF_FORMAT_DIR=$(dirname ${BF_FORMAT_F})
    if [ ! -d $BF_FORMAT_DIR ]; then
        mkdir -p $BF_FORMAT_DIR
    fi

    touch $BF_FORMAT_F
fi

# Get the readers and preprocessors for the reference and input images
<%-
require 'json'

mode_pairs = {
    "image_options" => {
        "modes" => {
            "reference" => "r",
            "input" => "i"
        },
        "options" => {
            "preprocessor" => "p",
            "reader" => "r"
        },
        "suffix" => "_image_"
    },
    "feature_detectors_options" => {
        "modes" => {
            "sorting" => "s",
            "matching" => "m"
        },
        "options" => {
            "feature_detector" => "fd"
        },
        "suffix" => "_"
    },
    "registration_options" => {
        "modes" => {
            "affine" => "a"
        },
        "options" => {
            "optimizer" => "o",
            "transformer" => "t"
        },
        "suffix" => "_"
    }
}

context_dict = context.to_h
widget_types = JSON.parse(context.json_bridge_type)

advanced_options = {}

mode_pairs.each do |advanced_option, advanced_option_modes|
    mode_suffix = advanced_option_modes["suffix"]
    advanced_option_modes["modes"].each do |mode_key, mode_flag|
        advanced_option_modes["options"].each do |opt_key, opt_key_flag|
            selected_option_name = context_dict["#{mode_key}#{mode_suffix}#{opt_key}".to_sym].downcase

            widget_arguments = widget_types.select { |key, value| key.to_s.start_with?("#{mode_key}#{mode_suffix}#{opt_key}_#{selected_option_name}_") }

            args_list = []

            widget_arguments.each do |arg_key, arg_type|
                arg_value = context_dict[arg_key.to_sym]
                if arg_type.include?('bool')
                    if arg_value == "1"
                        args_list << "#{arg_key.gsub("#{mode_key}#{mode_suffix}#{opt_key}_#{selected_option_name}_", "--#{mode_flag}#{opt_key_flag}-")}"
                    end
                else
                    args_list << "#{arg_key.gsub("#{mode_key}#{mode_suffix}#{opt_key}_#{selected_option_name}_", "--#{mode_flag}#{opt_key_flag}-")} #{arg_value}"
                end
            end

            advanced_options["#{mode_key}#{mode_suffix}#{opt_key}"] = args_list.join(" ")
        end
    end
end
-%>

# Execute registration pipeline ----------------------------------------------------------------
command="singularity run -B ${BF_FORMAT_F}:/root/.local/lib/python3.12/site-packages/valis/data/bf_formats.txt ${VALIS_CONTAINER}\
 -s ${REFERENCE_BASENAME} -t ${TEMP_DIR} -o ${OUTPUT_DIR}\
 -r ${REFERENCE_FILENAME}\
 -i ${INPUT_FILENAME}\
<%- mode_pairs.each do |advanced_option,advanced_option_modes|-%>
<%- mode_suffix = advanced_option_modes["suffix"] -%>
<%- advanced_option_modes["modes"].each do |mode_key,mode_flag| -%>
<%- advanced_option_modes["options"].each do |opt_key,opt_key_flag| -%>
 -<%= mode_flag %><%= opt_key_flag %> <%= context_dict["#{mode_key}#{mode_suffix}#{opt_key}".to_sym] %>\
 <%= advanced_options["#{mode_key}#{mode_suffix}#{opt_key}"] %> \
<%- end -%>
<%- end -%>
<%- end -%>
 -mp ${PROCESSING_SIZE}\
 -c ${CODEC} -cq ${QUALITY}\
 -y"

echo "$command"
eval "$command"

echo "TIMING - Finished Image Registration at: $(date)"

cp ${TEMP_DIR}/${REFERENCE_BASENAME}/overlaps/*rigid_overlap.png ${OOD_OUTPUT_DIR}/registration_thumbnail.png