<%-
require 'json'

# 1. Load the JSON file
base_json_path = Pathname.new(__dir__).join("form_options.json")

# Default to empty if file is missing (error handling)
if File.exist?(base_json_path)
  base_options_data = JSON.parse(File.read(base_json_path))
else
  base_options_data = {}
end

$available_custom_widgets = [
  "preprocessors",
  "readers",
  "feature_detectors",
  "affine_transformers",
  "affine_optimizers"
]

def deep_copy(obj)
  Marshal.load(Marshal.dump(obj))
end

def custom_widget(key, props, widget_name)
  custom_options_data = JSON.parse(File.read(Pathname.new(__dir__).join("scripts/#{widget_name}.json")))

  group_options_data = {
    "widget" => "select",
    "label" => props.fetch("label", key),
    "options" => custom_options_data.keys,
    "help" => props.fetch("help", ""),
    "group" => {},
    "visible" => "false",
    "add_show_checkbox" => false
  }

  custom_options_data.each do |opt, opt_props|
    if not opt_props["arguments"].empty?
      group_options_data["group"]["#{key}_#{opt}"] = {
        "label" => "#{opt}",
        "group" => {},
        "visible" => "false"
      }
    end

    opt_props["arguments"].each do |arg_key, arg_widget|
      group_options_data["group"]["#{key}_#{opt}"]["group"]["#{key}_#{opt}_#{arg_key}"] = arg_widget
    end
  end

  return group_options_data
end

def add_widget(key, props)
  # OOD prefixes all attributes with this string
  prefix = "batch_connect_session_context_"

  # The hash that stores the widget properties used to populate the form (flat)
  opt_data = {}
  
  # A hash that stores the variable types used in the script.sh (flat)
  opt_type = {}

  # A hash to store the hierarchy of nested options for show/hide functionallity (tree)
  opt_tree = {}

  if props.key?('widget') and $available_custom_widgets.include?props["widget"]
    props = custom_widget(key, props, props["widget"])
  end

  sub_opt_trees = {}

  ungrouped_props = props
  if props.key?('group') and props.key?('widget')
    ungrouped_props = deep_copy(props)
    ungrouped_props.delete('group')
    ungrouped_props.delete('visible')
  end

  # For custom widgets based on dropdown selection
  if ungrouped_props.key?('widget')
    opt_data[key.downcase.gsub('-', '_')] = ungrouped_props
    opt_data[key.downcase.gsub('-', '_')]["cacheable"] = "false"
    
    if ungrouped_props.key?('type')
      opt_type[key.downcase.gsub('-', '_')] = ungrouped_props['type']
    end

    if props.key?('group') and not props.fetch("add_show_checkbox", true)
      opt_tree["#{prefix}#{key.downcase.gsub('-', '_')}"] = sub_opt_trees
    end
  end

  if props.key?('group')
    if props.fetch("add_show_checkbox", true)
      opt_data["show_advanced_#{key.downcase.gsub('-', '_')}"] = {
        "widget" => "check_box",
        "label" => "Show #{props['label']}",
        "value" => props.fetch('visible', 'false'),
        "cacheable" => "false"
      }
    end

    props['group'].each do |sub_key, sub_props|
      # Recurse for each sub-widget
      sub_opt_data, sub_opt_type, sub_opt_tree = add_widget(sub_key, sub_props)

      if sub_opt_tree.empty?
        sub_opt_tree["#{prefix}#{sub_key.downcase.gsub('-', '_')}"] = {}
      end

      opt_data.update(sub_opt_data)
      opt_type.update(sub_opt_type)
      sub_opt_trees.update(sub_opt_tree)
    end

    if props.fetch("add_show_checkbox", true)
      opt_tree["#{prefix}show_advanced_#{key.downcase.gsub('-', '_')}"] = sub_opt_trees
    else
      opt_tree["#{prefix}#{key.downcase.gsub('-', '_')}"] = sub_opt_trees
    end
  end

  # Base recursion
  return opt_data, opt_type, opt_tree
end

options_data = {}
options_tree = {}
options_type = {}

base_options_data.each do |key, props|
  opt_data, opt_type, opt_tree = add_widget(key, props)

  options_data.update(opt_data)
  options_type.update(opt_type)
  options_tree.update(opt_tree)
end

options_tree = options_tree.to_json
options_type = options_type.to_json
-%>

# Batch Connect app configuration file

---

# **MUST** set cluster id here that matches cluster configuration file located
# under /etc/ood/config/clusters.d/*.yml
# @example Use the Owens cluster at Ohio Supercomputer Center
#     cluster: "owens"
cluster: "winter2"

attributes:
  modules: "apptainer"

  partition:
    label: "Partition"
    widget: select
    options:
        - ['compute']

  custom_qos:
    label: "QOS"
    widget: select
    options:
        - ['batch', data-exclusive-option-for-queue-compute: true]
        # - ['test', data-exclusive-option-for-queue-rit-test: true]
    help: "Currently, image registration jobs are limited to the compute partition and batch QOS."

  # 4. Programmatically Generate Attributes from JSON
<%- options_data.each do |key, props| -%>
  <%= key %>:
  <%- props.each do |prop_key, prop_val| -%>
    <%- if ["label", "help"].include?(prop_key) -%>
    <%= prop_key %>: "<%= prop_val %>"
    <%- elsif ["options"].include?(prop_key) -%>
    options:
        <%- prop_val.each do |opt| -%>
      - [<%= opt %>]
      <%- end -%>
    <%- else -%>
    <%= prop_key %>: <%= prop_val %>
    <%- end -%>
  <%- end -%>
<%- end -%>
  json_bridge_tree:
    widget: "hidden_field"
    value: '<%= options_tree %>'
    cacheable: false

  json_bridge_type:
    widget: "hidden_field"
    value: '<%= options_type %>'
    cacheable: false

form:
 - modules
 - partition
 - custom_qos
<%- options_data.each do |key, props| -%>
 - <%= key %>
<%- end -%>
 - json_bridge_tree
 - json_bridge_type